@@ -41,6 +41,11 @@ class FDBTransaction extends _FakeEventTarget.default {
       // the user uses `on*` or `addEventListener` for event listeners.
       this.addEventListener(type, () => {
         this._prioritizedListeners.get(type)?.();
+        if ((type === "complete" || type === "abort") && this._state === "finished") {
