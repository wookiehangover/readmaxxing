diff --git a/build/cjs/FDBTransaction.js b/build/cjs/FDBTransaction.js
index aea63bab6e8b88bcdb1aa3ff1fb5dbd24863aa67..741df60c535a66c6f2be8ff4ecba49fc90f63ddc 100644
--- a/build/cjs/FDBTransaction.js
+++ b/build/cjs/FDBTransaction.js
@@ -106,4 +106,10 @@ class FDBTransaction extends _FakeEventTarget.default {
         cancelable: false
       });
       event.eventPath = [this.db];
-      this.dispatchEvent(event);
+      try {
+        this.dispatchEvent(event);
+      } finally {
+        // Release only from the actual terminal lifecycle, after its callbacks.
+        // Synthetic events must not bypass pending work or upgrade-abort cleanup.
+        this.db._rawDatabase.transactions = this.db._rawDatabase.transactions.filter(transaction => transaction !== this);
+      }
@@ -254,7 +260,13 @@ class FDBTransaction extends _FakeEventTarget.default {
       this._state = "finished";
       if (!this.error) {
         const event = new _FakeEvent.default("complete");
-        this.dispatchEvent(event);
+        try {
+          this.dispatchEvent(event);
+        } finally {
+          // Release only from the actual terminal lifecycle, after its callbacks.
+          // Synthetic events must not bypass pending work or upgrade-abort cleanup.
+          this.db._rawDatabase.transactions = this.db._rawDatabase.transactions.filter(transaction => transaction !== this);
+        }
       }
     }
   }
