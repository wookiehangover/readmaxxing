# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?search_path=readmax

# WebAuthn / Passkey Auth
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# Admin API
ADMIN_API_TOKEN=

# Blob storage defaults to local filesystem in development and Vercel elsewhere.
# Override with "local" or "vercel" when needed.
BLOB_STORAGE_BACKEND=
# Required only when using the Vercel Blob backend.
BLOB_READ_WRITE_TOKEN=

# Redis (resumable chat streaming)
# Required in production. In dev, chat streaming falls back gracefully if unset.
# Vercel KV, Upstash, or any Redis-compatible URL works.
REDIS_URL=

# Reading artifacts agent (hosted by this app; production runs it in a Vercel Sandbox)
# Chat uses AI_GATEWAY_API_KEY too. READING_AGENT_SECRET authenticates the app-hosted agent.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
READING_AGENT_SECRET=
# Unused legacy external-host override. Leave empty; local ingest runs inside pnpm dev.
READING_AGENT_URL=
