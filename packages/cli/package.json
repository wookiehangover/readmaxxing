    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node --run build"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
