{
  "name": "@readmaxxing/cli",
  "version": "0.1.0",
  "description": "Upload and export your Readmaxxing library from the terminal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wookiehangover/readmaxxing.git",
    "directory": "packages/cli"
  },
  "bin": {
    "readmaxxing": "bin/readmaxxing.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
